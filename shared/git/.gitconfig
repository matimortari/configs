[user]
	email = matheus.felipe.19rt@gmail.com
	name = Matheus Mortari

[core]
	editor = code --wait
	autocrlf = false
	pager = less -+X
	quotepath = false
	preloadindex = true
	fscache = true

[init]
	defaultBranch = main

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[alias]
	fixup = !git add -A && git commit --amend --no-edit && git push --force-with-lease
	sync = "!f() { git fetch --all --prune; cur=$(git rev-parse --abbrev-ref HEAD); for b in $(git for-each-ref --format='%(refname:short)' refs/heads/); do up=$(git for-each-ref --format='%(upstream:short)' refs/heads/$b); if [ -n \"$up\" ]; then if [ \"$b\" = \"$cur\" ]; then git reset --hard \"$up\"; else git update-ref refs/heads/$b \"$up\"; fi; fi; done; }; f"
	co = checkout
	br = branch
	st = status
